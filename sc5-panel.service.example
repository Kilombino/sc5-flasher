[Unit]
Description=Panel de control del minero Goldshell SC5 Pro II (solo LAN, http://192.168.0.14:8099)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/start10/Projects/sc5-flasher
ExecStart=/usr/bin/python3 -m sc5 serve 192.168.0.197 --control --bind 192.168.0.14 --port 8099
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
