# systemd USER unit: keep the SC5 Pro II panel running and start it on boot.
# Install: edit the paths/IPs below, then
#   cp sc5-panel.service.example ~/.config/systemd/user/sc5-panel.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now sc5-panel.service
#   loginctl enable-linger "$USER"     # so it survives logout/reboot
[Unit]
Description=Goldshell SC5 Pro II control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sc5-flasher
# <MINER_IP>: the miner's LAN address. --bind <LAN_IP> to reach it from other
# devices (LAN only, no login); omit --bind to keep it on localhost.
ExecStart=/usr/bin/python3 -m sc5 serve <MINER_IP> --control --bind <LAN_IP> --port 8099
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
